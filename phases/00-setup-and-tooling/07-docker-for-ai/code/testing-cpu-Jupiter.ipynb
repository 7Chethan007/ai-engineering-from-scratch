    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "# CPU-only variant of this lesson's Dockerfile for Apple Silicon Macs.\n",
      "# See phases/00-setup-and-tooling/07-docker-for-ai/docs/en.md (\"No GPU?\" section).\n",
      "# PyTorch CPU wheels are ~200 MB; the CUDA devel base this replaces is ~4 GB.\n",
      "FROM python:3.12-slim\n",
      "\n",
      "ENV PYTHONUNBUFFERED=1\n",
      "ENV JUPYTER_TOKEN=''\n",
      "\n",
      "RUN python -m pip install --no-cache-dir \\\n",
      "    torch==2.6.0 \\\n",
      "    numpy \\\n",
      "    jupyter\n",
      "\n",
      "WORKDIR /workspace\n",
      "\n",
      "VOLUME [\"/workspace\", \"/models\"]\n",
      "\n",
      "EXPOSE 8888\n",
      "\n",
      "CMD [\"jupyter\", \"notebook\", \"--ip=0.0.0.0\", \"--port=8888\", \"--no-browser\", \"--allow-root\", \"--NotebookApp.token=''\"]\n",
      "\n"
     ]
    }
   ],
   "source": [
    "with open(\"Dockerfile.cpu\", \"r\") as f:\n",
    "    print(f.read())"
   ]
  },
